---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const now = new Date();

const posts = (await getCollection('posts'))
  .filter((post: CollectionEntry<'posts'>) => new Date(post.data.publishDate) <= now)
  .sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => 
    new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
  );
---

<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-MHJCVENH54"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-MHJCVENH54');
</script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Documentary Observations | Els Edes</title>
  <meta name="description" content="Observations on documentaries by filmmaker Els Edes">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Source+Sans+3:wght@400;600&display=block" as="style">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Source+Sans+3:wght@400;600&display=block" rel="stylesheet">
  
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
  <a href="/" class="site-logo">
    <img src="/els-edes-logo.webp" alt="Documentary Observations">
  </a>
  
  <header>
  <div>
    <h1>Documentary Observations</h1>
    <p>Notes on documentaries and handdrawn visuals by Els Edes
    </p>
  </div>
</header>
  <main>
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <a href={`/${post.slug}`}>
            <img 
              src={post.data.drawing} 
              alt={`Drawing for ${post.data.title}`}
              loading="lazy"
              width="800"
              height="533"
            />
            <div class="post-content">
              <h2>{post.data.title}</h2>
              <p class="meta">
                {post.data.director} · {post.data.releaseYear}
              </p>
              <p>{post.data.description}</p>
              <time datetime={post.data.publishDate}>
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>

 <footer>
  <div class="footer-nav">
    <a href="/about">About this website</a>
  </div>

    <div class="newsletter">
<form action="https://formspree.io/f/mdalooyb" method="POST">
  <input type="email" name="email" placeholder="Your email" required>
  <button type="submit">Subscribe</button>
</form>
  </div>

  <div>
